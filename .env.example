# Optional. Never commit live credentials, tokens, browser state, or private profile data.
BLOWBACK_HEADLESS=false
BLOWBACK_BROWSER=chromium
BLOWBACK_AUTH_DIR=.auth
BLOWBACK_RECORD_DIR=submission-records

# Optional Jev/System One decision plane. Keep credentials local and never commit them.
# TYPESAFE_API_KEY=<set-locally>
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# Optional absolute/relative path to a local JSON/YAML profile containing private fields.
# It is shallow-merged over the repo profile at runtime. Prefer a *.local.json file.
# BLOWBACK_PROFILE_FILE=/secure/path/profile.local.json
